{
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Chave de acesso no formato GIRO-XXXX-XXXX-XXXX"
    },
    "duration_days": {
      "type": "number",
      "description": "Validade da chave em dias (3, 5, 15, 30, 90, 180 ou 365)"
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "non_fiscal",
        "fiscal"
      ],
      "default": "non_fiscal",
      "description": "Plano contratado: sem emissão (non_fiscal) ou com emissão de NF (fiscal)"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "active",
        "expired",
        "revoked"
      ],
      "default": "available"
    },
    "client_name": {
      "type": "string",
      "description": "Nome da loja/cliente para quem a chave foi gerada"
    },
    "client_email": {
      "type": "string",
      "description": "Email do cliente (opcional)"
    },
    "activated_by": {
      "type": "string",
      "description": "Email do usuário que ativou a chave"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "company_id": {
      "type": "string",
      "description": "Empresa vinculada à chave após a ativação"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "key",
    "duration_days"
  ],
  "name": "AccessKey"
}
