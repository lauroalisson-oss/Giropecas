{
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Chave no formato GIRO-XXXX-XXXX-XXXX"
    },
    "duration_days": {
      "type": "number",
      "description": "Validade em dias"
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "non_fiscal",
        "fiscal"
      ],
      "default": "non_fiscal"
    },
    "fiscal_note_limit": {
      "type": "number",
      "default": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "active",
        "expired",
        "revoked"
      ],
      "default": "available"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "activated_by": {
      "type": "string"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "company_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "key",
    "duration_days"
  ],
  "name": "AccessKey",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": true,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}