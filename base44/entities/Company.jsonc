{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "cnpj": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "tax_regime": {
      "type": "string",
      "enum": [
        "simples_nacional",
        "lucro_presumido",
        "lucro_real"
      ],
      "default": "simples_nacional"
    },
    "plan": {
      "type": "string",
      "enum": [
        "basic",
        "pro",
        "enterprise"
      ],
      "default": "basic"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "logo_url": {
      "type": "string"
    },
    "nfe_enabled": {
      "type": "boolean",
      "default": false
    },
    "nfe_provider_url": {
      "type": "string"
    },
    "nfe_certificate": {
      "type": "string"
    },
    "fiscal_provider": {
      "type": "string",
      "enum": [
        "focus"
      ],
      "default": "focus",
      "description": "Gateway de emissão fiscal"
    },
    "nfe_environment": {
      "type": "string",
      "enum": [
        "homologacao",
        "producao"
      ],
      "default": "homologacao",
      "description": "Ambiente da SEFAZ: homologação (teste) ou produção (valor fiscal real)"
    },
    "ie": {
      "type": "string",
      "description": "Inscrição Estadual"
    },
    "im": {
      "type": "string",
      "description": "Inscrição Municipal"
    },
    "nfce_series": {
      "type": "string",
      "default": "1",
      "description": "Série da NFC-e"
    },
    "nfe_series": {
      "type": "string",
      "default": "1",
      "description": "Série da NF-e"
    },
    "csc": {
      "type": "string",
      "description": "Código de Segurança do Contribuinte (CSC) da NFC-e"
    },
    "csc_id": {
      "type": "string",
      "description": "ID/Token do CSC da NFC-e"
    },
    "fiscal_registered": {
      "type": "boolean",
      "default": false,
      "description": "Empresa já cadastrada no provedor fiscal (certificado enviado)"
    },
    "fiscal_cert_expires_at": {
      "type": "string",
      "format": "date",
      "description": "Validade do certificado digital A1"
    },
    "fiscal_status_message": {
      "type": "string",
      "description": "Última mensagem retornada pelo provedor fiscal"
    },
    "credit_conditions": {
      "type": "string"
    },
    "default_interest_rate": {
      "type": "number",
      "default": 0
    },
    "max_installments": {
      "type": "number",
      "default": 12
    }
  },
  "required": [
    "name"
  ],
  "name": "Company"
}