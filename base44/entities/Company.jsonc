{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "cnpj": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "tax_regime": {
      "type": "string",
      "enum": [
        "simples_nacional",
        "lucro_presumido",
        "lucro_real"
      ],
      "default": "simples_nacional"
    },
    "plan": {
      "type": "string",
      "enum": [
        "basic",
        "pro",
        "enterprise"
      ],
      "default": "basic"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "logo_url": {
      "type": "string"
    },
    "nfe_enabled": {
      "type": "boolean",
      "default": false
    },
    "nfe_provider_url": {
      "type": "string"
    },
    "nfe_certificate": {
      "type": "string"
    },
    "credit_conditions": {
      "type": "string"
    },
    "default_interest_rate": {
      "type": "number",
      "default": 0
    },
    "max_installments": {
      "type": "number",
      "default": 12
    }
  },
  "required": [
    "name"
  ],
  "name": "Company"
}