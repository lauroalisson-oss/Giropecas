{
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "sale_id": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "number": {
      "type": "string"
    },
    "series": {
      "type": "string",
      "default": "1"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "validando",
        "enviada",
        "autorizada",
        "rejeitada",
        "cancelada"
      ],
      "default": "rascunho"
    },
    "xml_content": {
      "type": "string"
    },
    "protocol": {
      "type": "string"
    },
    "danfe_url": {
      "type": "string"
    },
    "xml_url": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorized_at": {
      "type": "string",
      "format": "date-time"
    },
    "total_amount": {
      "type": "number"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "taxes": {
      "type": "object"
    },
    "cfop": {
      "type": "string"
    },
    "model": {
      "type": "string",
      "enum": [
        "nfce",
        "nfe",
        "nfse"
      ],
      "default": "nfce",
      "description": "Tipo do documento: NFC-e (65) e NF-e (55) são estaduais (mercadoria/ICMS); NFS-e é municipal (serviço/ISS)"
    },
    "rps_number": {
      "type": "string",
      "description": "Número do RPS (Recibo Provisório de Serviços) que originou a NFS-e"
    },
    "rps_series": {
      "type": "string",
      "default": "1",
      "description": "Série do RPS da NFS-e"
    },
    "verification_code": {
      "type": "string",
      "description": "Código de verificação da NFS-e no portal da prefeitura"
    },
    "nfse_url": {
      "type": "string",
      "description": "Link do PDF/consulta da NFS-e no portal do município"
    },
    "iss_amount": {
      "type": "number",
      "description": "Valor do ISS da NFS-e"
    },
    "service_amount": {
      "type": "number",
      "description": "Valor total dos serviços da NFS-e"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id"
  ],
  "name": "NFeRecord",
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}