{
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "internal_code": {
      "type": "string"
    },
    "barcode": {
      "type": "string",
      "description": "C\u00f3digo de barras (GTIN/EAN) para leitura via leitor/balan\u00e7a"
    },
    "lot": {
      "type": "string",
      "description": "Lote do produto (rastreabilidade para recall/validade)"
    },
    "ncm": {
      "type": "string"
    },
    "cfop_default": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "enum": [
        "un",
        "pc",
        "kg",
        "lt",
        "cx"
      ],
      "default": "un"
    },
    "cost_price": {
      "type": "number",
      "default": 0
    },
    "sale_price": {
      "type": "number",
      "default": 0
    },
    "margin_percent": {
      "type": "number",
      "default": 0
    },
    "stock_quantity": {
      "type": "number",
      "default": 0
    },
    "min_stock": {
      "type": "number",
      "default": 1
    },
    "location": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "lead_time_days": {
      "type": "number",
      "default": 1
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "brand": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "cest": {
      "type": "string",
      "description": "C\u00f3digo Especificador da Substitui\u00e7\u00e3o Tribut\u00e1ria (CEST)"
    },
    "origin": {
      "type": "string",
      "enum": [
        "0",
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7",
        "8"
      ],
      "default": "0",
      "description": "Origem: 0-Nacional, 1-Estrangeira importa\u00e7\u00e3o direta, 2-Estrangeira adquirida no mercado interno, 3-Nacional com conte\u00fado importado>40%, 4-Nacional produzida com insumos estrangeiros, 5-Nacional com conte\u00fado importado<40%, 6-Estrangeira importa\u00e7\u00e3o direta sem similar, 7-Estrangeira adquirida mercado interno sem similar, 8-Nacional com conte\u00fado importado"
    },
    "cbs_rate": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota CBS (Contribui\u00e7\u00e3o sobre Bens e Servi\u00e7os) - reforma tribut\u00e1ria (EC 132/2023), substitui PIS/COFINS"
    },
    "ibs_rate": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota IBS (Imposto sobre Bens e Servi\u00e7os) - reforma tribut\u00e1ria (EC 132/2023), substitui ICMS/ISS"
    },
    "cst_icms": {
      "type": "string",
      "description": "CST do ICMS (tabela vigente at\u00e9 transi\u00e7\u00e3o completa para IBS)"
    },
    "cst_pis": {
      "type": "string",
      "description": "CST do PIS/COFINS (tabela vigente at\u00e9 transi\u00e7\u00e3o completa para CBS)"
    },
    "cashback_percent": {
      "type": "number",
      "default": 0,
      "description": "Percentual de cashback da reforma tribut\u00e1ria (devolu\u00e7\u00e3o parcial de IBS/CBS para itens essenciais)"
    },
    "fiscal_benefit": {
      "type": "string",
      "description": "Benef\u00edcio fiscal / redu\u00e7\u00e3o de base de c\u00e1lculo (reforma tribut\u00e1ria prev\u00ea al\u00edquotas reduzidas para cesta b\u00e1sica, medicamentos, etc.)"
    }
  },
  "required": [
    "company_id",
    "description"
  ],
  "name": "Part",
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}