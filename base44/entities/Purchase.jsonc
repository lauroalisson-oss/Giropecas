{
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "enviada",
        "parcial",
        "recebida",
        "cancelada"
      ],
      "default": "rascunho"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "received_quantity": {
            "type": "number",
            "default": 0
          },
          "unit_cost": {
            "type": "number"
          },
          "total_price": {
            "type": "number"
          }
        }
      }
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "expected_date": {
      "type": "string",
      "format": "date"
    },
    "received_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id"
  ],
  "name": "Purchase",
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}