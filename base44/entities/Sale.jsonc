{
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "sale_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "os",
        "pdv"
      ],
      "default": "pdv"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "part",
              "service"
            ]
          },
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total_price": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "dinheiro",
        "cartao_debito",
        "cartao_credito",
        "pix",
        "crediario",
        "misto"
      ],
      "default": "dinheiro"
    },
    "payment_details": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "pago",
        "cancelado"
      ],
      "default": "pendente"
    },
    "nfe_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id"
  ],
  "name": "Sale",
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}